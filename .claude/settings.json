{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/session-start-handoff.ps1"
            ],
            "timeout": 15,
            "statusMessage": "Carregando docs/HANDOFF.md"
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Edit(**/*.unity)",
      "Edit(**/*.prefab)",
      "Edit(**/*.meta)",
      "Edit(**/*.asset)",
      "Edit(**/*.controller)",
      "Edit(**/*.anim)",
      "Edit(**/*.spriteatlasv2)"
    ]
  },
  "enabledPlugins": {
    "unity@anthropic-plugin-directory": true
  }
}
